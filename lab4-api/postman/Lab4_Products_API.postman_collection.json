{
  "info": {
    "name": "Lab4 Products API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Коллекция запросов для лабораторной работы 4"
  },
  "item": [
    {
      "name": "Get all products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["products"]
        }
      }
    },
    {
      "name": "Get products with category filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/products?category=Документы",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["products"],
          "query": [
            {
              "key": "category",
              "value": "Документы"
            }
          ]
        }
      }
    },
    {
      "name": "Get product by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/products/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["products", "1"]
        }
      }
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image\": \"https://via.placeholder.com/300x200?text=New\",\n  \"title\": \"Новый сервис проверки закупки\",\n  \"description\": \"Сервис для анализа закупочной документации\",\n  \"category\": \"Сервисы\",\n  \"price\": \"1990 ₽\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["products"]
        }
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": \"1290 ₽\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/products/2",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["products", "2"]
        }
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/products/4",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["products", "4"]
        }
      }
    }
  ]
}
